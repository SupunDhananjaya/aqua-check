{
  "name": "aqua-check",
  "version": "0.0.0",
  "description": "Check a waste-water sample against configurable discharge limits",
  "author": "Supun Dasanayaka",
  "main": "electron/main.js",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/SupunDhananjaya/aqua-check.git"
  },
  "type": "module",
  "bugs": {
    "url": "https://github.com/SupunDhananjaya/aqua-check/issues"
  },
  "homepage": "https://github.com/SupunDhananjaya/aqua-check#readme",
  "private": true,
  "dependencies": {
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-router": "^8.4.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@tailwindcss/vite": "^4.3.3",
    "@testing-library/jest-dom": "^7.0.1",
    "@testing-library/react": "^16.3.3",
    "@testing-library/user-event": "^14.6.7",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.1.2",
    "@vitest/coverage-v8": "^5.0.3",
    "concurrently": "^10.0.6",
    "electron": "^44.7.0",
    "electron-builder": "^26.15.3",
    "eslint": "^10.12.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-react-hooks": "^7.1.1",
    "eslint-plugin-react-refresh": "^0.5.7",
    "globals": "^17.13.0",
    "jsdom": "^29.1.1",
    "prettier": "^3.9.9",
    "prettier-plugin-tailwindcss": "^0.8.1",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.9",
    "typescript-eslint": "^8.71.1",
    "vite": "^8.3.4",
    "vitest": "^5.0.3",
    "wait-on": "^9.5.1"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "lint": "eslint .",
    "format": "prettier --write .",
    "test": "vitest run",
    "typecheck": "tsc -b --noEmit",
    "make-icon": "node scripts/make-icon.mjs",
    "electron:dev": "concurrently -k -n vite,electron \"vite\" \"wait-on http://localhost:5173 && electron . --dev\"",
    "electron:start": "npm run build && electron .",
    "electron:build": "npm run build && electron-builder --win portable"
  }
}
